{
    "name": "david-grosskost/suitecrm-ext-front-customizer",
    "description": "Personnalisation de l'interface de SuiteCRM 8 (module Angular) : montants au format français.",
    "type": "suitecrm-extension",
    "license": "proprietary",
    "require": {
        "php": ">=8.4"
    },
    "require-dev": {
        "david-grosskost/suitecrm-devkit": "^0.22"
    },
    "autoload-dev": {
        "psr-4": {
            "SuiteCrmExt\\FrontCustomizer\\Tests\\": "tests/"
        }
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/david-grosskost/suitecrm-devkit",
            "no-api": true
        }
    ],
    "config": {
        "sort-packages": true
    }
}
